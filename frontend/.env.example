# Base URL of the CardioTwin REST API. Empty (default) = same origin, i.e. requests go to /api/*
# (proxied to http://localhost:8000 by the Vite dev server, served by FastAPI in the Docker image).
VITE_API_URL=

# Dev server only: where the /api proxy forwards to.
VITE_API_PROXY=http://localhost:8000

# Milliseconds to wait for GET /api/health before falling back to the in-browser edge engine.
VITE_API_HEALTH_TIMEOUT_MS=1500
