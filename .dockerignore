# Keep the Docker build context small. backend/Dockerfile copies only: frontend/ (sources + public assets),
# ml/ (package, configs, artifacts), backend/, scripts/constraints.txt, scripts/runtime_requirements.py and
# docs/MODEL_CARD.md; everything else below is excluded.

# VCS, CI, editors, local tooling
.git
.gitignore
.gitattributes
.github
Makefile
.claude
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Secrets and local configuration
**/.env
**/.env.*

# Python environments and caches
.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/.coverage
**/htmlcov

# Node dependencies and build output (rebuilt inside the image)
**/node_modules
frontend/dist
frontend/.vite
**/*.tsbuildinfo

# Not needed at runtime: raw data, the anatomy build pipeline, tests, reports and media
data
anatomy
ml/tests
ml/reports
backend/tests
scripts/tests
docs/media
docs/figures
docs/design
docs/anatomy
**/*.blend
**/*.blend1
**/*.mp4
**/*.mov
